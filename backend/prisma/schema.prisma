generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  USUARIO
  AGENTE
  ADMIN
}

enum StatusChamado {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  papel     Papel    @default(USUARIO)
  criadoEm  DateTime @default(now()) @map("criado_em")

  chamadosAbertos     Chamado[]    @relation("ChamadosSolicitados")
  chamadosResponsavel Chamado[]    @relation("ChamadosResponsavel")
  comentarios         Comentario[]

  @@map("usuarios")
}

model Categoria {
  id   Int    @id @default(autoincrement())
  nome String @unique

  chamados Chamado[]

  @@map("categorias")
}

model Chamado {
  id            Int               @id @default(autoincrement())
  titulo        String
  descricao     String
  status        StatusChamado     @default(ABERTO)
  prioridade    PrioridadeChamado @default(MEDIA)
  categoriaId   Int?              @map("categoria_id")
  solicitanteId Int               @map("solicitante_id")
  responsavelId Int?              @map("responsavel_id")
  criadoEm      DateTime          @default(now()) @map("criado_em")
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em")

  categoria   Categoria?   @relation(fields: [categoriaId], references: [id])
  solicitante Usuario      @relation("ChamadosSolicitados", fields: [solicitanteId], references: [id])
  responsavel Usuario?     @relation("ChamadosResponsavel", fields: [responsavelId], references: [id])
  comentarios Comentario[]

  @@map("chamados")
}

model Comentario {
  id        Int      @id @default(autoincrement())
  chamadoId Int      @map("chamado_id")
  autorId   Int      @map("autor_id")
  mensagem  String
  criadoEm  DateTime @default(now()) @map("criado_em")

  chamado Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autor   Usuario @relation(fields: [autorId], references: [id])

  @@map("comentarios")
}
